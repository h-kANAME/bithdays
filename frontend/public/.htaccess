# =====================================================
# .htaccess - Sistema de Cumpleaños Frontend
# Para producción en subdirectorio
# =====================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Configuración de Base ---

  # LOCAL: No requiere RewriteBase (raíz del servidor)
  # PRODUCCIÓN: Configurar base para subdirectorio
  # RewriteBase /birthdays/

  # Detectar si estamos en producción (subdirectorio birthdays)
  RewriteCond %{REQUEST_URI} ^/birthdays/
  RewriteBase /birthdays/

  # --- Manejo de archivos estáticos ---

  # Si el archivo o directorio existe, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Redirigir todo al index.html (React Router)
  RewriteRule . /birthdays/index.html [L]

  # --- Headers de seguridad ---

  <IfModule mod_headers.c>
    # Habilitar CORS si es necesario
    Header set Access-Control-Allow-Origin "*"

    # Seguridad
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"

    # Cache para archivos estáticos
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # No cachear el index.html
    <FilesMatch "index\.html$">
      Header set Cache-Control "no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
      Header set Expires 0
    </FilesMatch>
  </IfModule>

  # --- Compresión ---

  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml
  </IfModule>

</IfModule>

# --- Prevenir listado de directorios ---
Options -Indexes

# --- Tipo MIME correcto para archivos JS ---
<IfModule mod_mime.c>
  AddType application/javascript js
  AddType application/json json
</IfModule>
