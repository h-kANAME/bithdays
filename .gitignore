# =====================================================
# Git Ignore - Sistema de Cumpleaños
# =====================================================

# ⚠️ ARCHIVOS CRÍTICOS CON CREDENCIALES - NUNCA COMMITEAR
.env
.env.local
.env.production
.env.*.local
.env.*.production
backend/.env
backend/.env.local
backend/.env.production

# Archivos SQL que puedan contener datos sensibles
*.sql.gz
*.sql.bak
backup.sql
fix_password.sql

# === Node modules ===
node_modules/
frontend/node_modules/
backend/node_modules/
*/node_modules/

# === Logs (pueden contener credenciales) ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
composer.log

# === Docker ===
docker-compose.override.yml
.dockerignore

# === IDE y Editores ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.sublime-project
*.sublime-workspace

# === Build y compilación ===
frontend/build/
frontend/.env.local
frontend/.env.production
dist/
build/

# === Cache y temporales ===
.cache/
*.cache
temp/
tmp/

# === Dependencias específicas ===
backend/vendor/
composer.lock
package-lock.json

# === Archivos de sistema ===
.env.*.swp
.env.*.swo
**/._*
.AppleDouble
.LSOverride

# === Archivos de prueba sensibles ===
test_*.php
debug_*.php

# Scripts personalizados con credenciales (NO subir)
backend/generate_user_password.php

# === Variables de entorno no procesadas ===
.env.*.pem
.env.*.key
*.pem
*.key
