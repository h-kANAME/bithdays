# =====================================================
# CONFIGURACIÓN PRODUCCIÓN - Sistema de Cumpleaños
# =====================================================
# Copiar este archivo a .env en producción

# === Entorno ===
APP_ENV=production
APP_URL=https://kyz.com.ar/birthdays

# === Base de Datos ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=birthdays_db
DB_USER=birthdays_user
DB_PASS=your_production_password

# === EmailJS ===
EMAILJS_SERVICE_ID=service_3pd0b4d
EMAILJS_TEMPLATE_ID=template_o36zf6a
EMAILJS_PUBLIC_KEY=ssSdj5ZqeLxWVCj7N

# === Autenticación ===
# IMPORTANTE: Usar el mismo secret que se usó al crear los usuarios
# Si cambias este valor, TODOS los tokens existentes quedarán inválidos
JWT_SECRET=production_secret_key_at_least_32_characters_long_change_this
ACCESS_TOKEN_EXPIRY=30d

# === CORS (Opcional) ===
ALLOWED_ORIGINS=https://kyz.com.ar

# === Configuración de Email ===
EMAIL_FROM_NAME=Sistema de Cumpleaños
EMAIL_FROM_EMAIL=noreply@kyz.com.ar
