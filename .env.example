# =====================================================
# CONFIGURACIÓN DE ENTORNO - Sistema de Cumpleaños
# =====================================================
# Copiar este archivo a .env y configurar los valores
# NUNCA commitear credenciales reales - SOLO usar valores de ejemplo

# === Entorno ===
APP_ENV=production
APP_URL=https://tudominio.com/birthdays

# === Base de Datos ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=database_name
DB_USER=database_user
DB_PASS=secure_password_here

# === EmailJS ===
# Obtener credenciales en: https://www.emailjs.com/
EMAILJS_SERVICE_ID=service_xxxxxxxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxxxxxxx
EMAILJS_PUBLIC_KEY=public_key_xxxxxxxxxxxx

# === Autenticación ===
# Generar un secret seguro de al menos 32 caracteres con: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here_minimum_32_characters
ACCESS_TOKEN_EXPIRY=30d

# === Frontend ===
# Para desarrollo local: http://localhost:3000
# Para producción: actualiza según tu configuración
REACT_APP_API_URL=/birthdays/backend/public

# === CORS (Opcional) ===
# Dominios permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:3000,https://kyz.com.ar

# === Configuración de Email ===
EMAIL_FROM_NAME=Sistema de Cumpleaños
EMAIL_FROM_EMAIL=noreply@kyz.com.ar
